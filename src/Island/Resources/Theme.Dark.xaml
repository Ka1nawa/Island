<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="TextSecondary" Color="#A8A8AE" />
  <SolidColorBrush x:Key="TextTertiary" Color="#6F6F76" />
  <SolidColorBrush x:Key="Accent" Color="#0A84FF" />
  <SolidColorBrush x:Key="Surface" Color="#12FFFFFF" />
  <SolidColorBrush x:Key="Stroke" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="SurfaceSoft" Color="#0DFFFFFF" />
  <SolidColorBrush x:Key="SurfaceHover" Color="#16FFFFFF" />
  <SolidColorBrush x:Key="BorderSoft" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="ShellBorder" Color="#2AFFFFFF" />
  <SolidColorBrush x:Key="OverlaySolid" Color="#DE0A0A10" />
  <SolidColorBrush x:Key="MenuSolid" Color="#FF141419" />
  <SolidColorBrush x:Key="MenuText" Color="#EAEAEF" />

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource MenuSolid}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
