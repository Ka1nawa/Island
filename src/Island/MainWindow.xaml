<Window x:Class="Island.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Island.Views"
        xmlns:controls="clr-namespace:Island.Controls"
        Title="{DynamicResource AppName}"
        Width="472" Height="448"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">

  <Window.Resources>
    <Style x:Key="MenuItemButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource MenuText}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Height" Value="30" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceHover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="RootGrid" Background="{x:Null}">
    <Border x:Name="Shell" Width="240" Height="44" CornerRadius="22"
            Background="Transparent"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0"
            BorderBrush="{DynamicResource ShellBorder}" BorderThickness="1"
            ClipToBounds="True" RenderTransformOrigin="0.5,0.5"
            MouseEnter="Shell_MouseEnter" MouseLeave="Shell_MouseLeave" MouseLeftButtonUp="Shell_MouseLeftButtonUp">
      <Border.RenderTransform>
        <TranslateTransform />
      </Border.RenderTransform>

      <Grid>
        <Grid x:Name="GlassHost" ClipToBounds="True">
          <Canvas x:Name="GlassCanvas">
            <Image x:Name="GlassImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality">
              <Image.RenderTransform>
                <TranslateTransform x:Name="GlassOffset" />
              </Image.RenderTransform>
            </Image>
          </Canvas>
          <Border x:Name="TintLayer" />
          <Border x:Name="AccentLayer" IsHitTestVisible="False" Background="Transparent" />
          <Border IsHitTestVisible="False">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#16FFFFFF" Offset="0" />
                <GradientStop Color="#00FFFFFF" Offset="0.32" />
                <GradientStop Color="#1E000000" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </Grid>

        <Grid x:Name="CollapsedView" Width="240" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center"
              ToolTip="{DynamicResource TipOpen}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Grid Grid.Column="0" Width="38" Height="44">
            <Border Width="30" Height="30" CornerRadius="9" Background="#16FFFFFF" ClipToBounds="True"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding Media.HasMedia, Converter={StaticResource BoolToVisibility}}">
              <Grid>
                <Border CornerRadius="9" RenderOptions.BitmapScalingMode="HighQuality">
                  <Border.Background>
                    <ImageBrush ImageSource="{Binding Media.Artwork}" Stretch="UniformToFill" />
                  </Border.Background>
                </Border>
                <TextBlock Text="&#x266B;" FontSize="13" Foreground="#6C6C76" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Media.HasArtwork, Converter={StaticResource InverseBoolToVisibility}}" />
              </Grid>
            </Border>
            <TextBlock Text="{Binding Clock}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Visibility="{Binding Media.HasMedia, Converter={StaticResource InverseBoolToVisibility}}" />
          </Grid>

          <TextBlock Grid.Column="1" Text="{Binding Media.Title}" FontSize="11" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0"
                     Visibility="{Binding Media.HasMedia, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Grid.Column="1" Text="{Binding DateLine}" FontSize="10.5" Foreground="{DynamicResource TextTertiary}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"
                     Visibility="{Binding Media.HasMedia, Converter={StaticResource InverseBoolToVisibility}}" />

          <StackPanel x:Name="EqStack" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                      Height="14" Margin="0,0,4,0"
                      Visibility="{Binding ShowEqualizer, Converter={StaticResource BoolToVisibility}}">
            <Rectangle x:Name="EqBar1" Width="3" Height="13" RadiusX="1.5" RadiusY="1.5" Fill="#FF8E8E9A"
                       VerticalAlignment="Center" RenderTransformOrigin="0.5,1">
              <Rectangle.RenderTransform><ScaleTransform ScaleY="0.35" /></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="EqBar2" Width="3" Height="13" RadiusX="1.5" RadiusY="1.5" Fill="#FF8E8E9A"
                       VerticalAlignment="Center" Margin="2,0" RenderTransformOrigin="0.5,1">
              <Rectangle.RenderTransform><ScaleTransform ScaleY="0.35" /></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="EqBar3" Width="3" Height="13" RadiusX="1.5" RadiusY="1.5" Fill="#FF8E8E9A"
                       VerticalAlignment="Center" RenderTransformOrigin="0.5,1">
              <Rectangle.RenderTransform><ScaleTransform ScaleY="0.35" /></Rectangle.RenderTransform>
            </Rectangle>
          </StackPanel>

          <TextBlock x:Name="TimerChip" Grid.Column="2" Text="{Binding TimerText}" FontSize="11.5" FontWeight="SemiBold"
                     Foreground="#FFFFB86B" VerticalAlignment="Center" Margin="0,0,8,0"
                     Visibility="{Binding HasTimer, Converter={StaticResource BoolToVisibility}}"
                     MouseLeftButtonUp="TimerChip_Click" ToolTip="{DynamicResource TimerStop}" />

          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                      Background="Transparent" MouseLeftButtonUp="WeatherChip_Click" ToolTip="{DynamicResource TipWeather}">
            <controls:WeatherIcon Kind="{Binding Weather.IconKind}" Width="17" Height="17" VerticalAlignment="Center" Opacity="0.92" />
            <TextBlock Text="{Binding Weather.TemperatureText}" FontSize="12.5" FontWeight="SemiBold"
                       Margin="5,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>

        <Grid x:Name="ExpandedView" Width="448" Height="424" Visibility="Collapsed" Opacity="0" Cursor="Arrow">
          <Grid Margin="18,14,18,16">
            <Grid.RowDefinitions>
              <RowDefinition Height="30" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BackButton" Style="{StaticResource IconButton}" Width="26" Height="26"
                        Margin="0,0,6,0" Click="Back_Click" Visibility="Collapsed" ToolTip="{DynamicResource Back}">
                  <TextBlock Text="&#xE72B;" Style="{StaticResource Glyph}" FontSize="10" />
                </Button>
                <TextBlock Text="{Binding Clock}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding DateLine}" FontSize="10.5" Foreground="{StaticResource TextTertiary}"
                           Margin="8,1,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding MeetingHint}" FontSize="10" Foreground="#8FB8FF"
                           Margin="8,1,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150"
                           Visibility="{Binding HasMeetingHint, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Width="26" Height="26"
                        Click="OpenSettings_Click" ToolTip="{DynamicResource TipSettings}">
                  <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" FontSize="11" />
                </Button>
                <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Width="26" Height="26"
                        Click="OpenMenu_Click" Margin="2,0,0,0" ToolTip="{DynamicResource TipMenu}">
                  <TextBlock Text="&#xE712;" Style="{StaticResource Glyph}" FontSize="12" />
                </Button>
                <Button x:Name="CollapseButton" Style="{StaticResource IconButton}" Width="26" Height="26"
                        Click="Collapse_Click" Margin="2,0,0,0" ToolTip="{DynamicResource TipCollapse}">
                  <TextBlock Text="&#xE70E;" Style="{StaticResource Glyph}" FontSize="11" />
                </Button>
              </StackPanel>
            </Grid>

            <Border x:Name="TabsBorder" Grid.Row="1" Height="32" CornerRadius="10" Background="{DynamicResource SurfaceSoft}" Padding="3" Margin="0,8,0,0">
              <UniformGrid Columns="5">
                <RadioButton x:Name="TabMedia" Style="{StaticResource Segment}" Content="{DynamicResource TabMusic}" Tag="0"
                             IsChecked="True" Checked="Tab_Checked" />
                <RadioButton x:Name="TabSound" Style="{StaticResource Segment}" Content="{DynamicResource TabSound}" Tag="1" Checked="Tab_Checked" />
                <RadioButton x:Name="TabWeather" Style="{StaticResource Segment}" Content="{DynamicResource TabWeather}" Tag="2" Checked="Tab_Checked" />
                <RadioButton x:Name="TabPlans" Style="{StaticResource Segment}" Content="{DynamicResource TabPlans}" Tag="3" Checked="Tab_Checked" />
                <RadioButton x:Name="TabSystem" Style="{StaticResource Segment}" Content="{DynamicResource TabSystem}" Tag="4" Checked="Tab_Checked" />
              </UniformGrid>
            </Border>

            <Grid x:Name="PagesHost" Grid.Row="2" Margin="0,12,0,0">
              <views:MediaPage x:Name="MediaView" />
              <views:SoundPage x:Name="SoundView" Visibility="Collapsed" />
              <views:WeatherPage x:Name="WeatherView" Visibility="Collapsed" />
              <views:PlansPage x:Name="PlansView" Visibility="Collapsed" />
              <views:SystemPage x:Name="SystemView" Visibility="Collapsed" />
            </Grid>

            <Border x:Name="OverlayHost" Grid.Row="1" Grid.RowSpan="2" Margin="0,8,0,0" Visibility="Collapsed"
                    Background="{DynamicResource OverlaySolid}" CornerRadius="16" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" Padding="14,12">
              <Grid>
                <views:SettingsSheet x:Name="SettingsView" Visibility="Collapsed" />
                <views:AboutSheet x:Name="AboutView" Visibility="Collapsed" />
                <views:CommandSheet x:Name="CommandView" Visibility="Collapsed" />
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Border>

    <Popup x:Name="MenuPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
           PopupAnimation="Fade" Closed="MenuPopup_Closed">
      <Border Width="184" Background="{DynamicResource MenuSolid}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1"
              CornerRadius="12" Padding="4">
        <Border.Effect>
          <DropShadowEffect BlurRadius="18" ShadowDepth="6" Direction="270" Opacity="0.55" Color="#000000" />
        </Border.Effect>
        <StackPanel>
          <Button Style="{StaticResource MenuItemButton}" Content="{DynamicResource MenuQuick}" Click="MenuQuick_Click" />
          <Button Style="{StaticResource MenuItemButton}" Content="{DynamicResource MenuSettings}" Click="MenuSettings_Click" />
          <Button Style="{StaticResource MenuItemButton}" Content="{DynamicResource MenuAbout}" Click="MenuAbout_Click" />
          <Border Height="1" Background="{DynamicResource BorderSoft}" Margin="8,3" />
          <Button Style="{StaticResource MenuItemButton}" Content="{DynamicResource MenuUpdate}" Click="MenuUpdate_Click" />
          <Button Style="{StaticResource MenuItemButton}" Content="{DynamicResource MenuRefreshWeather}" Click="MenuRefresh_Click" />
          <Button Style="{StaticResource MenuItemButton}" Content="{DynamicResource MenuCollapse}" Click="MenuCollapse_Click" />
          <Border Height="1" Background="{DynamicResource BorderSoft}" Margin="8,3" />
          <Button Style="{StaticResource MenuItemButton}" Content="{DynamicResource MenuExit}" Foreground="#FF6B5E" Click="MenuExit_Click" />
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>