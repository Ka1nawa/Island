<Window x:Class="Island.StickyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Island.Controls"
        Width="260" Height="170" WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}">
  <Border x:Name="Card" CornerRadius="14" Background="{DynamicResource MenuSolid}"
          BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#000000" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="30" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border x:Name="Header" CornerRadius="13,13,0,0" MouseLeftButtonDown="Header_MouseDown">
        <Grid Margin="10,0,6,0">
          <TextBlock x:Name="TitleText" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" Margin="0,0,26,0" />
          <Button Style="{StaticResource IconButton}" Width="22" Height="22" HorizontalAlignment="Right"
                  VerticalAlignment="Center" Click="Close_Click" ToolTip="{DynamicResource Delete}">
            <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="9" />
          </Button>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" Margin="10,6,10,8" Style="{StaticResource CleanScroll}"
                    VerticalScrollBarVisibility="Auto">
        <controls:MarkdownText x:Name="BodyText" FontSize="10.5" TextWrapping="Wrap" MaxLines="20"
                               Foreground="{DynamicResource TextSecondary}" />
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
