<Window x:Class="Island.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="384" Height="92" WindowStyle="None" AllowsTransparency="True"
        Background="{x:Null}" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" ResizeMode="NoResize" WindowStartupLocation="Manual">
  <Border x:Name="Card" Background="Transparent" BorderBrush="#2EFFFFFF" BorderThickness="1"
          CornerRadius="20" ClipToBounds="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="26" ShadowDepth="10" Direction="270" Opacity="0.55" Color="#000000" />
    </Border.Effect>
    <Grid>
      <Grid x:Name="GlassHost" ClipToBounds="True">
        <Canvas>
          <Image x:Name="GlassImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
        </Canvas>
        <Border x:Name="TintLayer" />
      </Grid>

      <Grid Margin="14,11,10,11">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="38" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border x:Name="IconHost" Width="34" Height="34" CornerRadius="12" VerticalAlignment="Center">
          <TextBlock x:Name="IconGlyph" Style="{StaticResource Glyph}" FontSize="15" />
        </Border>

        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="MessageText" FontSize="9.5" Foreground="#A8A8B0" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="Snooze5Button" Style="{StaticResource IconButton}" Width="26" Height="26" Click="Snooze5_Click">
            <TextBlock x:Name="Snooze5Text" FontSize="9" />
          </Button>
          <Button x:Name="Snooze10Button" Style="{StaticResource IconButton}" Width="26" Height="26" Margin="1,0,0,0" Click="Snooze10_Click">
            <TextBlock x:Name="Snooze10Text" FontSize="9" />
          </Button>
          <Button x:Name="Snooze30Button" Style="{StaticResource IconButton}" Width="26" Height="26" Margin="1,0,0,0" Click="Snooze30_Click">
            <TextBlock x:Name="Snooze30Text" FontSize="9" />
          </Button>
          <Button x:Name="DoneButton" Style="{StaticResource FlatOkButton}" Margin="4,0,0,0" Click="Done_Click">
            <TextBlock x:Name="DoneText" FontSize="10.5" />
          </Button>
        </StackPanel>
      </Grid>

      <Border x:Name="Progress" Height="2" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="384" Opacity="0.35">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#000A84FF" Offset="0" />
            <GradientStop Color="#FF4FA8FF" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
    </Grid>
  </Border>
</Window>
