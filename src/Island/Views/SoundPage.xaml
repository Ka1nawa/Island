<UserControl x:Class="Island.Views.SoundPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="PresetChip" TargetType="Button">
      <Setter Property="Foreground" Value="#D8D8E0" />
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{DynamicResource SurfaceHover}" CornerRadius="8" Padding="9,4"
                    BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#26FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ComboBox Grid.Row="0" Style="{StaticResource DarkCombo}" Height="32" Margin="0,0,0,8"
              ToolTip="{DynamicResource OutputDevice}"
              ItemsSource="{Binding Sound.Devices}"
              SelectedItem="{Binding Sound.SelectedDevice, Mode=TwoWay}">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <Border Grid.Row="1" Height="56" CornerRadius="16" Background="{DynamicResource SurfaceSoft}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
      <Grid Margin="9,0,13,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="36" />
        </Grid.ColumnDefinitions>
        <Button Style="{StaticResource IconButton}" Width="28" Height="28" Click="MasterMute_Click">
          <TextBlock Text="{Binding Sound.MasterGlyph}" Style="{StaticResource Glyph}" FontSize="13" />
        </Button>
        <Slider Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="100"
                Value="{Binding Sound.MasterVolume, Mode=TwoWay}" Margin="4,0" />
        <TextBlock Grid.Column="2" Text="{Binding Sound.MasterText}" FontSize="10.5"
                   Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="2,10,2,0">
      <TextBlock Text="{DynamicResource Presets}" FontSize="11" FontWeight="SemiBold"
                 Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Style="{StaticResource PresetChip}" Content="{DynamicResource PresetGame}" Click="ApplyGame_Click" />
        <Button Style="{StaticResource IconButton}" Width="22" Height="22" Click="SaveGame_Click"
                ToolTip="{DynamicResource SavePreset}" Margin="0,0,10,0">
          <TextBlock Text="&#xE74E;" Style="{StaticResource Glyph}" FontSize="9" />
        </Button>
        <Button Style="{StaticResource PresetChip}" Content="{DynamicResource PresetWork}" Click="ApplyWork_Click" />
        <Button Style="{StaticResource IconButton}" Width="22" Height="22" Click="SaveWork_Click"
                ToolTip="{DynamicResource SavePreset}" Margin="2,0,0,0">
          <TextBlock Text="&#xE74E;" Style="{StaticResource Glyph}" FontSize="9" />
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="3" Margin="2,12,2,4">
      <TextBlock Text="{DynamicResource Apps}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
      <TextBlock Text="{Binding Sound.AppCountText}" FontSize="10" Foreground="{StaticResource TextTertiary}"
                 HorizontalAlignment="Right" />
    </Grid>

    <Grid Grid.Row="4">
      <ScrollViewer Style="{StaticResource CleanScroll}" VerticalScrollBarVisibility="Hidden">
        <ItemsControl ItemsSource="{Binding Sound.Apps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Height="44" CornerRadius="10" Padding="8,0,4,0" Margin="0,1">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#0AFFFFFF" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="128" />
                    <ColumnDefinition Width="26" />
                  </Grid.ColumnDefinitions>

                  <Grid Width="24" Height="24" VerticalAlignment="Center">
                    <Border CornerRadius="7" Background="{DynamicResource SurfaceHover}" />
                    <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ShowInitial, Converter={StaticResource BoolToVisibility}}" />
                    <Image Source="{Binding Icon}" Stretch="Uniform" Width="20" Height="20"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="&#xE767;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{DynamicResource TextTertiary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ShowSpeaker, Converter={StaticResource BoolToVisibility}}" />
                  </Grid>

                  <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="9" Foreground="{StaticResource TextTertiary}"
                               Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>

                  <Slider Grid.Column="2" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="100"
                          Value="{Binding Volume, Mode=TwoWay}" Margin="0,0,10,0" />

                  <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="26" Height="26"
                          Click="AppMute_Click" ToolTip="{DynamicResource MuteTip}">
                    <TextBlock Text="{Binding MuteGlyph}" Style="{StaticResource Glyph}" FontSize="12" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                  Visibility="{Binding Sound.HasApps, Converter={StaticResource InverseBoolToVisibility}}">
        <TextBlock Text="{DynamicResource NoApps}" FontSize="11.5" Foreground="{StaticResource TextTertiary}" />
        <TextBlock Text="{DynamicResource NoAppsHint}" FontSize="9.5"
                   Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Center" Margin="0,3,0,0" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
