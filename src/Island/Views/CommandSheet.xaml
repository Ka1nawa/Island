<UserControl x:Class="Island.Views.CommandSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="CmdButton" TargetType="Button">
      <Setter Property="Foreground" Value="#EAEAEF" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="#14FFFFFF" CornerRadius="9" Padding="{TemplateBinding Padding}"
                    BorderBrush="#22FFFFFF" BorderThickness="1">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#26FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="{DynamicResource QuickActions}" FontSize="15" FontWeight="SemiBold" />

    <TextBox x:Name="InputBox" Grid.Row="1" Style="{StaticResource FieldBox}" Height="34" FontSize="13"
             Margin="0,10,0,0" TextChanged="Input_Changed" KeyDown="Input_KeyDown" />

    <TextBlock x:Name="PreviewText" Grid.Row="2" FontSize="9.5" Foreground="{StaticResource TextTertiary}"
               Margin="2,4,0,0" TextWrapping="Wrap" />

    <TextBlock Grid.Row="3" Text="{DynamicResource QuickHint2}" FontSize="9" Foreground="{StaticResource TextTertiary}"
               Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="390" VerticalAlignment="Top" />

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Style="{StaticResource CmdButton}" Content="{DynamicResource QuickNote}" Margin="0,0,6,0" Click="Note_Click" />
      <Button Style="{StaticResource CmdButton}" Content="{DynamicResource QuickReminder}" Click="Reminder_Click" />
    </StackPanel>
  </Grid>
</UserControl>
