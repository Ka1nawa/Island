<UserControl x:Class="Island.Views.SystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="ThinBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="6" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border Background="{DynamicResource BorderSoft}" CornerRadius="3" />
              <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3"
                      HorizontalAlignment="Left" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Text="{DynamicResource TabSystem}" FontSize="15" FontWeight="SemiBold" />
    <TextBlock Text="{DynamicResource SystemHint}" FontSize="9.5" Foreground="{DynamicResource TextTertiary}"
               Margin="0,3,0,0" TextWrapping="Wrap" />

    <Grid Margin="0,16,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="{DynamicResource Cpu}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
      <TextBlock Text="{Binding System.CpuText}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
      <ProgressBar Grid.Row="1" Style="{StaticResource ThinBar}" Foreground="#0A84FF"
                   Value="{Binding System.CpuValue, Mode=OneWay}" Margin="0,6,0,0" />
    </Grid>

    <Grid Margin="0,16,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="{DynamicResource Gpu}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
      <TextBlock Text="{Binding System.GpuText}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
      <ProgressBar Grid.Row="1" Style="{StaticResource ThinBar}" Foreground="#32D74B"
                   Value="{Binding System.GpuValue, Mode=OneWay}" Margin="0,6,0,0" />
    </Grid>

    <Grid Margin="0,16,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="{DynamicResource Ram}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
      <TextBlock Text="{Binding System.RamText}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
      <ProgressBar Grid.Row="1" Style="{StaticResource ThinBar}" Foreground="#FF9F0A"
                   Value="{Binding System.RamValue, Mode=OneWay}" Margin="0,6,0,0" />
    </Grid>
  </StackPanel>
</UserControl>
