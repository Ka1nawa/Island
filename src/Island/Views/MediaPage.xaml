<UserControl x:Class="Island.Views.MediaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Island.Controls">
  <UserControl.Resources>
    <Style x:Key="ChipButton" TargetType="Button">
      <Setter Property="Foreground" Value="#A8A8AE" />
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{DynamicResource SurfaceSoft}" CornerRadius="6" Padding="7,2">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#22FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PlayGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
      <Setter Property="Text" Value="&#xE768;" />
      <Setter Property="Foreground" Value="#08080A" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Media.IsPlaying}" Value="True">
          <Setter Property="Text" Value="&#xE769;" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid Visibility="{Binding Media.HasMedia, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="104">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="104" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Width="104" Height="104" CornerRadius="22" Background="{DynamicResource SurfaceSoft}" ClipToBounds="True">
            <Grid>
              <Image Source="{Binding Media.Artwork}" Stretch="UniformToFill"
                     RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock Text="&#x266B;" FontSize="34" Foreground="#3C3C45"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding Media.HasArtwork, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
          </Border>

          <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Media.Title}" FontSize="18" FontWeight="SemiBold"
                       TextWrapping="Wrap" MaxHeight="46" TextTrimming="CharacterEllipsis" LineHeight="22" />
            <TextBlock Text="{Binding Media.Artist}" FontSize="13" Foreground="{StaticResource TextSecondary}"
                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding Media.Artist, Converter={StaticResource StringToVisibility}}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Border Background="{DynamicResource SurfaceSoft}" CornerRadius="6" Padding="7,2"
                      Visibility="{Binding Media.HasAppName, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Media.AppName}" FontSize="9.5" Foreground="{DynamicResource TextSecondary}" />
              </Border>
              <Button Style="{StaticResource ChipButton}" Content="{DynamicResource Lyrics}" Click="Lyrics_Click"
                      Margin="6,0,0,0" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,12,0,0">
          <Grid Visibility="{Binding Media.HasDuration, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Slider Style="{StaticResource ThinSlider}" Minimum="0" Maximum="{Binding Media.Duration}"
                    Value="{Binding Media.Position, Mode=TwoWay}" />
            <Grid Grid.Row="1" Margin="0,4,0,0">
              <TextBlock Text="{Binding Media.PositionText}" FontSize="9.5" Foreground="{StaticResource TextTertiary}" />
              <TextBlock Text="{Binding Media.DurationText}" FontSize="9.5" Foreground="{StaticResource TextTertiary}"
                         HorizontalAlignment="Right" />
            </Grid>
          </Grid>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="{Binding Media.HasDuration, Converter={StaticResource InverseBoolToVisibility}}">
            <Ellipse Width="6" Height="6" Fill="#FF453A" VerticalAlignment="Center" />
            <TextBlock Text="{DynamicResource Live}" FontSize="10" Foreground="{StaticResource TextTertiary}" Margin="7,0,0,0" />
          </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Height="46" Margin="0,4,0,0">
          <controls:VisualizerControl x:Name="Visualizer" Height="42"
                                      Visibility="{Binding Media.ShowVisualizer, Converter={StaticResource BoolToVisibility}}" />
          <StackPanel VerticalAlignment="Center"
                      Visibility="{Binding Media.IsLyricsMode, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Media.CurrentLyricText}" FontSize="12" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Media.NextLyricText}" FontSize="10" Foreground="{StaticResource TextTertiary}"
                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            <TextBlock Text="{Binding Media.LyricsStatusText}" FontSize="9" Foreground="{StaticResource TextTertiary}"
                       Margin="0,1,0,0"
                       Visibility="{Binding Media.LyricsStatusText, Converter={StaticResource StringToVisibility}}" />
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button Style="{StaticResource IconButton}" Width="38" Height="38" Click="Prev_Click">
            <TextBlock Text="&#xE892;" Style="{StaticResource Glyph}" FontSize="16" />
          </Button>
          <Button Style="{StaticResource PlayButton}" Margin="16,0" Click="Play_Click">
            <TextBlock Style="{StaticResource PlayGlyph}" FontSize="21" />
          </Button>
          <Button Style="{StaticResource IconButton}" Width="38" Height="38" Click="Next_Click">
            <TextBlock Text="&#xE893;" Style="{StaticResource Glyph}" FontSize="16" />
          </Button>
        </StackPanel>
      </Grid>

      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                  Visibility="{Binding Media.HasMedia, Converter={StaticResource InverseBoolToVisibility}}">
        <Border Width="60" Height="60" CornerRadius="30" Background="{DynamicResource SurfaceSoft}" HorizontalAlignment="Center">
          <TextBlock Text="&#x266B;" FontSize="24" Foreground="#55555F"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="{DynamicResource NothingPlaying}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
        <TextBlock Text="{DynamicResource StartMusic}" FontSize="10.5"
                   Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" Margin="0,4,0,0" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Height="46" CornerRadius="14" Background="{DynamicResource SurfaceSoft}"
            BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
      <Grid Margin="9,0,13,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="36" />
        </Grid.ColumnDefinitions>
        <Button Style="{StaticResource IconButton}" Width="28" Height="28" Click="MasterMute_Click">
          <TextBlock Text="{Binding Sound.MasterGlyph}" Style="{StaticResource Glyph}" FontSize="13" />
        </Button>
        <Slider Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="100"
                Value="{Binding Sound.MasterVolume, Mode=TwoWay}" Margin="4,0" />
        <TextBlock Grid.Column="2" Text="{Binding Sound.MasterText}" FontSize="10.5"
                   Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
