<UserControl x:Class="Island.Views.PlansPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Island.Controls">
  <UserControl.Resources>
    <Style x:Key="ColorDot" TargetType="RadioButton">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="ring" Width="22" Height="22" CornerRadius="11" BorderThickness="2"
                    BorderBrush="Transparent" Background="Transparent">
              <Ellipse Width="14" Height="14" Fill="{TemplateBinding Background}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ring" Property="BorderBrush" Value="#EAFFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CheckItem" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#C8C8D0" />
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Margin" Value="0,1,0,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="box" Width="12" Height="12" CornerRadius="3" BorderBrush="{DynamicResource BorderSoft}"
                      BorderThickness="1" Background="{DynamicResource SurfaceSoft}" VerticalAlignment="Center">
                <TextBlock x:Name="check" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                           Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
              </Border>
              <ContentPresenter Margin="5,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="check" Property="Visibility" Value="Visible" />
                <Setter TargetName="box" Property="Background" Value="#3B2F7DFF" />
                <Setter TargetName="box" Property="BorderBrush" Value="#AA2F7DFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PresetChip" TargetType="Button">
      <Setter Property="Foreground" Value="#D8D8E0" />
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Margin" Value="0,0,5,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{DynamicResource SurfaceHover}" CornerRadius="8" Padding="8,4"
                    BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#26FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FlatTextButton" TargetType="Button">
      <Setter Property="Foreground" Value="#0A84FF" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#14FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Height="28">
      <Border Width="198" Height="28" Background="{DynamicResource SurfaceSoft}" CornerRadius="9" Padding="3" HorizontalAlignment="Left">
        <UniformGrid Columns="2">
          <RadioButton x:Name="NotesTab" Style="{StaticResource Segment}" FontSize="11"
                       Content="{DynamicResource Notes}" IsChecked="True" Tag="0" Checked="PlansTab_Checked" />
          <RadioButton x:Name="RemindersTab" Style="{StaticResource Segment}" FontSize="11"
                       Content="{DynamicResource Reminders}" Tag="1" Checked="PlansTab_Checked" />
        </UniformGrid>
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Style="{StaticResource IconButton}" Width="24" Height="24" Click="ExportNotes_Click" ToolTip="{DynamicResource ExportNotes}">
          <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="10" />
        </Button>
        <Button Style="{StaticResource IconButton}" Width="24" Height="24" Margin="2,0,0,0" Click="ImportNotes_Click" ToolTip="{DynamicResource ImportNotes}">
          <TextBlock Text="&#xE898;" Style="{StaticResource Glyph}" FontSize="10" />
        </Button>
        <Button x:Name="AddButton" Style="{StaticResource IconButton}" Width="28" Height="28" Margin="2,0,0,0" Click="Add_Click" ToolTip="{DynamicResource AddNote}">
          <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="12" />
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="0,8,0,0">
      <Grid x:Name="NotesHost">
        <ScrollViewer Style="{StaticResource CleanScroll}">
          <ItemsControl ItemsSource="{Binding Plans.Notes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="196" Height="104" CornerRadius="14" Margin="0,0,6,6"
                        Background="{Binding CardBackground}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1"
                        Cursor="Hand" MouseLeftButtonUp="Note_Click">
                  <Grid Margin="12,10">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Row="1" Margin="0,5,0,0">
                      <controls:MarkdownText Markdown="{Binding Body}" MaxLines="3" FontSize="10"
                                             Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxHeight="46"
                                             Visibility="{Binding HasChecklist, Converter={StaticResource InverseBoolToVisibility}}" />
                      <ItemsControl ItemsSource="{Binding Checklist}"
                                    Visibility="{Binding HasChecklist, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <CheckBox Style="{StaticResource CheckItem}" IsChecked="{Binding IsDone, Mode=OneWay}" Click="Checklist_Click">
                              <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                            </CheckBox>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                Visibility="{Binding HasReminder, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="&#xE823;" Style="{StaticResource Glyph}" FontSize="9" Foreground="{DynamicResource TextSecondary}" />
                      <TextBlock Text="{Binding ReminderText}" FontSize="9" Foreground="{DynamicResource TextSecondary}" Margin="4,0,0,0" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding Plans.HasNotes, Converter={StaticResource InverseBoolToVisibility}}">
          <TextBlock Text="{DynamicResource NoNotes}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="{DynamicResource NoNotesHint}" FontSize="10" Foreground="{StaticResource TextTertiary}"
                     HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
      </Grid>

      <Grid x:Name="RemindersHost" Visibility="Collapsed">
        <ScrollViewer Style="{StaticResource CleanScroll}">
          <ItemsControl ItemsSource="{Binding Plans.Reminders}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Height="46" CornerRadius="10" Margin="0,1" Background="Transparent">
                  <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="52" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding TimeText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center" Background="Transparent"
                                Cursor="Hand" MouseLeftButtonUp="Reminder_Click">
                      <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding RepeatText}" FontSize="9" Foreground="{StaticResource TextTertiary}"
                                 Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding Plans.HasReminders, Converter={StaticResource InverseBoolToVisibility}}">
          <TextBlock Text="{DynamicResource NoReminders}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="{DynamicResource NoRemindersHint}" FontSize="10" Foreground="{StaticResource TextTertiary}"
                     HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
      </Grid>
    </Grid>

    <!-- note editor -->
    <Border x:Name="NoteEditor" Grid.RowSpan="2" Background="{DynamicResource MenuSolid}" CornerRadius="16" Padding="14,12"
            Visibility="Collapsed" Opacity="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Height="22">
          <TextBlock Text="{DynamicResource Notes}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Style="{StaticResource IconButton}" Width="24" Height="24" HorizontalAlignment="Right" Click="CloseEditor_Click">
            <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="10" />
          </Button>
        </Grid>

        <TextBox x:Name="NoteTitleBox" Grid.Row="1" Style="{StaticResource FieldBox}" Margin="0,6,0,0"
                 ToolTip="{DynamicResource NoteTitle}" />
        <TextBox x:Name="NoteBodyBox" Grid.Row="2" Style="{StaticResource AreaBox}" Height="86" Margin="0,6,0,0"
                 ToolTip="{DynamicResource NoteBody}" />

        <Grid Grid.Row="3" Margin="0,8,0,0">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="Color0" Style="{StaticResource ColorDot}" Background="#F5C542" Tag="0" IsChecked="True" />
            <RadioButton x:Name="Color1" Style="{StaticResource ColorDot}" Background="#FF6B9A" Tag="1" />
            <RadioButton x:Name="Color2" Style="{StaticResource ColorDot}" Background="#59A8FF" Tag="2" />
            <RadioButton x:Name="Color3" Style="{StaticResource ColorDot}" Background="#32D74B" Tag="3" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource PinNote}" FontSize="9.5" Foreground="{DynamicResource TextTertiary}"
                       VerticalAlignment="Center" Margin="0,0,6,0" />
            <CheckBox x:Name="NotePinCheck" Style="{StaticResource Switch}" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
          <CheckBox x:Name="NoteReminderCheck" Style="{StaticResource Switch}" Click="NoteReminder_Toggled" />
          <TextBlock Text="{DynamicResource RemindMe}" FontSize="10.5" Foreground="{StaticResource TextSecondary}"
                     VerticalAlignment="Center" Margin="8,0,8,0" />
          <TextBox x:Name="NoteReminderDate" Style="{StaticResource FieldBox}" Width="104" Height="28" FontSize="11" />
          <TextBox x:Name="NoteReminderTime" Style="{StaticResource FieldBox}" Width="70" Height="28" FontSize="11" Margin="4,0,0,0" />
        </StackPanel>

        <Grid Grid.Row="6" Margin="0,6,0,0">
          <Button Content="{DynamicResource Delete}" Style="{StaticResource FlatTextButton}" Foreground="#FF6B5E"
                  HorizontalAlignment="Left" Click="DeleteNote_Click" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Cancel}" Style="{StaticResource FlatTextButton}" Foreground="{DynamicResource TextSecondary}" Click="CloseEditor_Click" />
            <Button Content="{DynamicResource Save}" Style="{StaticResource FlatTextButton}" Click="SaveNote_Click" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- reminder editor -->
    <Border x:Name="ReminderEditor" Grid.RowSpan="2" Background="{DynamicResource MenuSolid}" CornerRadius="16" Padding="14,12"
            Visibility="Collapsed" Opacity="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Height="22">
          <TextBlock Text="{DynamicResource Reminders}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Style="{StaticResource IconButton}" Width="24" Height="24" HorizontalAlignment="Right" Click="CloseEditor_Click">
            <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="10" />
          </Button>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,6,0,0">
          <TextBox x:Name="QuickReminderBox" Style="{StaticResource FieldBox}" Height="30" FontSize="11"
                   TextChanged="QuickReminder_Changed" KeyDown="QuickReminder_KeyDown"
                   ToolTip="{DynamicResource QuickHint}" />
          <TextBlock x:Name="QuickPreview" FontSize="9.5" Foreground="{StaticResource TextTertiary}"
                     Margin="2,3,0,0" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Style="{StaticResource PresetChip}" Content="{DynamicResource PresetWater}" Tag="water" Click="Preset_Click" />
            <Button Style="{StaticResource PresetChip}" Content="{DynamicResource PresetBreak}" Tag="break" Click="Preset_Click" />
            <Button Style="{StaticResource PresetChip}" Content="{DynamicResource PresetDuolingo}" Tag="duolingo" Click="Preset_Click" />
            <Button Style="{StaticResource PresetChip}" Content="{DynamicResource QuickApply}" Tag="apply" Click="QuickApply_Click" />
          </StackPanel>
          <TextBox x:Name="ReminderTitleBox" Style="{StaticResource FieldBox}" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource TimeText}" FontSize="10.5" Foreground="{StaticResource TextSecondary}"
                     VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox x:Name="ReminderTimeBox" Style="{StaticResource FieldBox}" Width="78" Height="28" FontSize="11" />
          <TextBlock Text="{DynamicResource DateText}" FontSize="10.5" Foreground="{StaticResource TextSecondary}"
                     VerticalAlignment="Center" Margin="14,0,8,0" x:Name="DateLabel" />
          <TextBox x:Name="ReminderDateBox" Style="{StaticResource FieldBox}" Width="106" Height="28" FontSize="11" />
        </StackPanel>

        <Border Grid.Row="3" Height="28" Background="{DynamicResource SurfaceSoft}" CornerRadius="9" Padding="3" Margin="0,8,0,0">
          <UniformGrid Columns="4">
            <RadioButton x:Name="RepeatOnce" Style="{StaticResource Segment}" FontSize="9.5" Content="{DynamicResource RepeatOnce}" Tag="Once" Checked="Repeat_Checked" />
            <RadioButton x:Name="RepeatHourly" Style="{StaticResource Segment}" FontSize="9.5" Content="{DynamicResource RepeatHourly}" Tag="Hourly" Checked="Repeat_Checked" />
            <RadioButton x:Name="RepeatDaily" Style="{StaticResource Segment}" FontSize="9.5" Content="{DynamicResource RepeatDaily}" Tag="Daily" IsChecked="True" Checked="Repeat_Checked" />
            <RadioButton x:Name="RepeatWeekly" Style="{StaticResource Segment}" FontSize="9.5" Content="{DynamicResource RepeatWeekly}" Tag="Weekly" Checked="Repeat_Checked" />
          </UniformGrid>
        </Border>

        <StackPanel x:Name="WeekdayRow" Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
          <ToggleButton x:Name="DayMon" Style="{StaticResource ChipToggle}" Content="{DynamicResource WeekdayMon}" Tag="1" />
          <ToggleButton x:Name="DayTue" Style="{StaticResource ChipToggle}" Content="{DynamicResource WeekdayTue}" Tag="2" />
          <ToggleButton x:Name="DayWed" Style="{StaticResource ChipToggle}" Content="{DynamicResource WeekdayWed}" Tag="4" />
          <ToggleButton x:Name="DayThu" Style="{StaticResource ChipToggle}" Content="{DynamicResource WeekdayThu}" Tag="8" />
          <ToggleButton x:Name="DayFri" Style="{StaticResource ChipToggle}" Content="{DynamicResource WeekdayFri}" Tag="16" />
          <ToggleButton x:Name="DaySat" Style="{StaticResource ChipToggle}" Content="{DynamicResource WeekdaySat}" Tag="32" />
          <ToggleButton x:Name="DaySun" Style="{StaticResource ChipToggle}" Content="{DynamicResource WeekdaySun}" Tag="64" />
        </StackPanel>

        <Grid Grid.Row="7" Margin="0,6,0,0">
          <Button Content="{DynamicResource Delete}" Style="{StaticResource FlatTextButton}" Foreground="#FF6B5E"
                  HorizontalAlignment="Left" Click="DeleteReminder_Click" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Cancel}" Style="{StaticResource FlatTextButton}" Foreground="{DynamicResource TextSecondary}" Click="CloseEditor_Click" />
            <Button Content="{DynamicResource Save}" Style="{StaticResource FlatTextButton}" Click="SaveReminder_Click" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>