<UserControl x:Class="Island.Views.WeatherPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Island.Controls">
  <UserControl.Resources>
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="Background" Value="#0DFFFFFF" />
      <Setter Property="BorderBrush" Value="#12FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="#0A84FF" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="7,4">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ResultRow" TargetType="Button">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="10" Padding="10,8" Margin="0,1">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#12FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <ScrollViewer Style="{StaticResource CleanScroll}" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <!-- city row -->
        <Grid Height="24">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xE707;" Style="{StaticResource Glyph}" FontSize="10" Foreground="{DynamicResource TextTertiary}" Margin="2,0,6,0" />
            <TextBlock Text="{Binding Weather.CityName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="150" />
            <Button Style="{StaticResource IconButton}" Width="20" Height="20" Margin="4,0,0,0" Click="PrevCity_Click"
                    ToolTip="{DynamicResource PrevCity}" AutomationProperties.Name="{DynamicResource PrevCity}"
                    Visibility="{Binding Weather.CanSwitchCity, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="&#xE76B;" Style="{StaticResource Glyph}" FontSize="8" />
            </Button>
            <Button Style="{StaticResource IconButton}" Width="20" Height="20" Margin="2,0,0,0" Click="NextCity_Click"
                    ToolTip="{DynamicResource NextCity}" AutomationProperties.Name="{DynamicResource NextCity}"
                    Visibility="{Binding Weather.CanSwitchCity, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="8" />
            </Button>
            <TextBlock Text="{Binding Weather.CitySubtitle}" FontSize="10" Foreground="{StaticResource TextTertiary}"
                       Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="110" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Style="{StaticResource IconButton}" Width="26" Height="26" Click="RefreshWeather_Click" ToolTip="{DynamicResource TipRefresh}">
              <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="10" />
            </Button>
            <Button Style="{StaticResource IconButton}" Width="26" Height="26" Click="OpenSearch_Click" ToolTip="{DynamicResource TipCity}" Margin="2,0,0,0">
              <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="10" />
            </Button>
          </StackPanel>
        </Grid>

        <!-- hero -->
        <Grid Height="92" Margin="0,2,0,0">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Weather.TemperatureText}" FontFamily="{StaticResource DisplayFont}"
                       FontSize="42" FontWeight="SemiBold" LineHeight="48" Margin="-2,-4,0,0" />
            <TextBlock Text="{Binding Weather.ConditionText}" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" Margin="1,0,0,0" />
            <TextBlock Text="{Binding Weather.FeelsText}" FontSize="10" Foreground="{StaticResource TextTertiary}" Margin="1,2,0,0" />

            <Border Background="#2EFF9F0A" CornerRadius="7" Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Left"
                    Visibility="{Binding Weather.HasWarning, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{Binding Weather.WarningText}" FontSize="9" Foreground="#FFB340" />
            </Border>
          </StackPanel>

          <Grid Width="92" Height="92" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-4,-4,0">
            <Ellipse Width="92" Height="92">
              <Ellipse.Fill>
                <RadialGradientBrush>
                  <GradientStop Color="#3B1E6BFF" Offset="0" />
                  <GradientStop Color="#000A84FF" Offset="1" />
                </RadialGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
            <controls:WeatherIcon Kind="{Binding Weather.IconKind}" Width="66" Height="66"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Grid>

        <!-- details -->
        <Grid Height="38">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource Chip}" Margin="0,0,5,0">
            <StackPanel Margin="10,0" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource Wind}" FontSize="9" Foreground="{DynamicResource TextTertiary}" />
              <TextBlock Text="{Binding Weather.WindText}" FontSize="11" FontWeight="SemiBold" Margin="0,1,0,0" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Style="{StaticResource Chip}" Margin="0,0,5,0">
            <StackPanel Margin="10,0" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource Humidity}" FontSize="9" Foreground="{DynamicResource TextTertiary}" />
              <TextBlock Text="{Binding Weather.HumidityText}" FontSize="11" FontWeight="SemiBold" Margin="0,1,0,0" />
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource Chip}">
            <StackPanel Margin="10,0" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource Today}" FontSize="9" Foreground="{DynamicResource TextTertiary}" />
              <TextBlock Text="{Binding Weather.HighLowText}" FontSize="10.5" FontWeight="SemiBold" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- hourly -->
        <Border Height="78" CornerRadius="14" Background="{DynamicResource SurfaceSoft}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" Margin="0,6,0,0" Padding="4,0">
          <ItemsControl ItemsSource="{Binding Weather.Hours}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Width="50" VerticalAlignment="Center">
                  <TextBlock Text="{Binding TimeText}" FontSize="9" Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Center" />
                  <controls:WeatherIcon Kind="{Binding Kind}" Width="20" Height="20" HorizontalAlignment="Center" Margin="0,6" Opacity="0.9" />
                  <TextBlock Text="{Binding TempText}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- daily -->
        <Border Height="50" CornerRadius="14" Background="{DynamicResource SurfaceSoft}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" Margin="0,6,0,0" Padding="4,0">
          <ItemsControl ItemsSource="{Binding Weather.Days}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding DayText}" FontSize="8.5" Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Center" />
                  <controls:WeatherIcon Kind="{Binding Kind}" Width="16" Height="16" HorizontalAlignment="Center" Margin="0,3" Opacity="0.9" />
                  <TextBlock Text="{Binding TempText}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding PrecipText}" FontSize="8" Foreground="#6FA8FF" HorizontalAlignment="Center"
                             Visibility="{Binding HasPrecip, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- footer -->
        <Grid Margin="2,4,2,2">
          <TextBlock Text="{Binding Weather.UpdatedText}" FontSize="9" Foreground="{DynamicResource TextTertiary}" />
          <TextBlock Text="{Binding Weather.ErrorText}" FontSize="9" Foreground="#FF9F0A" HorizontalAlignment="Right"
                     Visibility="{Binding Weather.HasError, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <!-- city search -->
    <Border CornerRadius="16" Background="{DynamicResource MenuSolid}" Padding="2"
            Visibility="{Binding Weather.IsSearching, Converter={StaticResource BoolToVisibility}}">
      <Grid Margin="6,4,6,2">
        <Grid.RowDefinitions>
          <RowDefinition Height="32" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="10" Foreground="{DynamicResource TextTertiary}" />
          <TextBox x:Name="SearchInput" Grid.Column="1" Style="{StaticResource SearchBox}" Margin="4,0,6,0"
                   TextChanged="SearchInput_TextChanged" KeyDown="SearchInput_KeyDown" />
          <Button Grid.Column="2" Style="{StaticResource LinkButton}" Click="CancelSearch_Click">
            <TextBlock Text="{DynamicResource Cancel}" Foreground="#0A84FF" FontSize="11.5" />
          </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Style="{StaticResource CleanScroll}" Margin="0,6,0,0">
          <ItemsControl ItemsSource="{Binding Weather.Results}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource ResultRow}" Click="City_Click">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="12.5" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="9.5" Foreground="{StaticResource TextTertiary}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Text="{DynamicResource SearchCityHint}" FontSize="10.5" Foreground="{DynamicResource TextTertiary}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding Weather.ShowHint, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Grid.Row="1" Text="{DynamicResource NothingFound}" FontSize="10.5" Foreground="{DynamicResource TextTertiary}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding Weather.ShowNoResults, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
